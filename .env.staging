# FormaconIA Staging Environment Configuration

# Application
APP_ENV=staging
DEBUG=False
APP_NAME=FormaconIA Auth Service - Staging
VERSION=0.1.0

# Database (Staging PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/formacionia_staging

# Redis (Staging Cache)
REDIS_URL=redis://redis:6379/1

# JWT Configuration
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

# Password Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_FAILED_ATTEMPTS=3
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_LOCK_MINUTES=15

# Email Configuration (SendGrid)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=${SENDGRID_API_KEY}
EMAIL_FROM=noreply@staging.formacionia.ai
EMAIL_FROM_NAME=FormaconIA Staging

# CORS Configuration
ALLOWED_ORIGINS=https://staging.formacionia.ai,https://staging-app.formacionia.ai,http://localhost:3000

# Security
SECRET_KEY=${STAGING_SECRET_KEY}

# Logging
LOG_LEVEL=INFO

# Token Expiry
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_HOURS=24

# Session Configuration
SESSION_EXPIRE_DAYS=7

# Database Cleanup
CLEANUP_ENABLED=True
CLEANUP_INTERVAL_HOURS=24
