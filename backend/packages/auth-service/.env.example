# Application
APP_ENV=development
DEBUG=True
APP_NAME=FormaconIA Auth Service

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formacion_auth

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate with: openssl genrsa -out private.pem 2048
# Generate with: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=private.pem
JWT_PUBLIC_KEY_PATH=public.pem

# Password Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_FAILED_ATTEMPTS=3
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_LOCK_MINUTES=15

# Email Configuration
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=sg_your_key_here
EMAIL_FROM=noreply@formacion.ai
EMAIL_FROM_NAME=FormaconIA

# Alternative: AWS SES
# EMAIL_PROVIDER=aws_ses
# AWS_SES_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8000

# Security
SECRET_KEY=your-secret-key-min-256-chars-for-production

# Logging
LOG_LEVEL=INFO

# Verification Token Expiry
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_HOURS=24

# Session
SESSION_EXPIRE_DAYS=7

# Database Cleanup (background tasks)
CLEANUP_ENABLED=True
CLEANUP_INTERVAL_HOURS=24
